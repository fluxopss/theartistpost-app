{
  "expo": {
    "name": "The Artist Post",
    "slug": "theartistpost-app",
    "owner": "fluxlabsfloridas-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "theartistpost",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#071A2E",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/874b50c8-20fc-4610-8c1f-f9c1c0aba065"
    },
    "ios": {
      "bundleIdentifier": "agency.fluxlab.theartistpost.dev",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "agency.fluxlab.theartistpost.dev",
      "adaptiveIcon": {
        "backgroundColor": "#071A2E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#071A2E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/ClashDisplay-Semibold.ttf",
            "./assets/fonts/ClashDisplay-Bold.ttf",
            "./assets/fonts/Jost-Regular.ttf",
            "./assets/fonts/Jost-Medium.ttf",
            "./assets/fonts/Jost-SemiBold.ttf"
          ]
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "expo-sharing",
      "expo-video",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "874b50c8-20fc-4610-8c1f-f9c1c0aba065"
      }
    }
  }
}
