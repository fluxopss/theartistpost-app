{
  "expo": {
    "name": "The Artist Post",
    "slug": "theartistpost-app",
    "owner": "fluxlabsfloridas-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "theartistpost",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#071A2E",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/874b50c8-20fc-4610-8c1f-f9c1c0aba065"
    },
    "ios": {
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#071A2E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#071A2E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/ClashDisplay-Semibold.ttf",
            "./assets/fonts/ClashDisplay-Bold.ttf",
            "./assets/fonts/Jost-Regular.ttf",
            "./assets/fonts/Jost-Medium.ttf",
            "./assets/fonts/Jost-SemiBold.ttf"
          ]
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "The Artist Post uses your location once, only when you tap “I’m here” at a night, to confirm you’re at the house. It is never saved, tracked or shared.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false,
          "motionUsagePermission": "The Artist Post does not use motion or fitness data."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The Artist Post uses your photos so you can add pictures to your profile and posts. Only the picture you choose is uploaded.",
          "cameraPermission": "The Artist Post does not use your camera. Pick a photo from your library instead.",
          "microphonePermission": "The Artist Post does not use your microphone."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "The Artist Post uses your calendar only to add a night you choose to save. It does not read or change your other events.",
          "remindersPermission": "The Artist Post does not use your reminders."
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "The Artist Post does not use Face ID."
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "expo-video",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "874b50c8-20fc-4610-8c1f-f9c1c0aba065"
      }
    }
  }
}
